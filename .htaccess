LimitRequestBody 10485760

<IfModule mod_php7.c>
    php_value upload_max_filesize 2M
    php_value post_max_size 10M
    php_value memory_limit 128M
</IfModule>

Options -Indexes
RewriteEngine On

# Handle Authorization Header
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Protect ONLY root data directory (does not break /kyc/data/)
RewriteRule ^/?data/ - [F,L]

# Redirect contact.html to contact.php
RewriteRule ^contact\.html$ /contact.php [L,R=301]

# Exclude /kyc/ directory and existing files/folders from HTML fallback
RewriteCond %{REQUEST_URI} !^/kyc/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]