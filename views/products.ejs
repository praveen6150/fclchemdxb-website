<%- include('partials/header') %>

<div class="page-card">
    <div class="page-card-header">
        <h2><i class="fas fa-flask" style="color:#C8102E;margin-right:8px;"></i>Divisions &amp; Products</h2>
        <% if (currentUser && currentUser.role === 'admin') { %>
        <a href="/admin/products/create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Add Division</a>
        <% } %>
    </div>
    <div class="page-card-body" style="padding:0;">
        <% if (!products || products.length === 0) { %>
        <div class="empty-state"><i class="fas fa-flask"></i><p>No divisions found.</p></div>
        <% } else { %>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Division</th>
                        <th>Sections</th>
                        <th>Catalogue</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(function(p) { %>
                    <tr>
                        <td><%= p.id %></td>
                        <td>
                            <strong><%= p.title %></strong>
                            <div style="color:#888;font-size:12px;"><%= p.slug %></div>
                        </td>
                        <td><span class="badge badge-info"><%= (p.accordion && p.accordion.length) || 0 %> sections</span></td>
                        <td>
                            <% if (p.catalogue) { %>
                            <span class="badge badge-success">Yes</span>
                            <% } else { %>
                            <span class="badge badge-danger">No</span>
                            <% } %>
                        </td>
                        <td style="display:flex;gap:6px;flex-wrap:wrap;">
                            <a href="/admin/products/edit/<%= p.id %>" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a href="/<%= p.slug %>.html" target="_blank" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i> View
                            </a>
                            <% if (currentUser && currentUser.role === 'admin') { %>
                            <a href="/admin/products/delete/<%= p.id %>" class="btn btn-sm btn-danger confirm-delete">
                                <i class="fas fa-trash"></i>
                            </a>
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
